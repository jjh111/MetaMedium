.DS_Store

# Dependencies & build output
node_modules/
metamedium-core/dist/

# NOTE: v2-poc/src/ was previously ignored, so the v2-poc source was never
# committed — only the built bundle.js. Commit the source from the machine
# that has it (see ROADMAP.md).

# manim-explainer: renders and cache are build output, reproducible from
# script.py / monolith.py. Source, plan, and preview stills are tracked.
manim-explainer/media/
manim-explainer/__pycache__/
manim-explainer/*.mp4

# Secrets never enter git: keys are typed into the surface that uses them
# or read by a process from its environment (SURFACE-v9-PLAN.md D9).
.env
.env.*
!.env.example
