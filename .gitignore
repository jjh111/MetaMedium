# macOS junk
.DS_Store

# Dependencies & build output
node_modules/
core/dist/
dynaink-3d/node_modules/
dynaink-3d/dist/

# NOTE: v2-poc/src/ was previously ignored, so the v2-poc source was never
# committed — only the built bundle.js. Commit the source from the machine
# that has it (see ROADMAP.md).

# manim-explainer: renders and cache are build output, reproducible from
# script.py / monolith.py. Source, plan, and preview stills are tracked.
manim-explainer/media/
manim-explainer/__pycache__/
manim-explainer/*.mp4

# launch-video: the MP4 and stills are build output of `node launch-video/render.mjs`.
launch-video/out/

# Secrets never enter git: keys are typed into the surface that uses them
# or read by a process from its environment (SURFACE-v9-PLAN.md D9).
.env
.env.*
!.env.example

# Assets/make-card.mjs stages a copy of index.html beside it (the hero needs
# its own relative assets) and gives Chrome a scratch profile. Both are removed
# on the way out; these cover a run that was killed.
.card-build.html
.card-build-profile/

# The browser gate (e2e/): Playwright and a run's structured results. The
# runner and its lockfile are tracked; what it downloads and what it writes are not.
e2e/node_modules/
e2e/results/
# A trailing slash matches directories only; a symlinked node_modules slipped
# past it once (diagrams-visible-states), so ignore the name however it is made.
node_modules

# A release's standalone file (scripts/release.mjs): attached to the GitHub
# release, never committed.
/dist/
